{
  "name": "mern-cicd-task-manager",
  "version": "1.0.0",
  "description": "Full-stack MERN Task Management Application with automated CI/CD pipeline",
  "main": "server/server.js",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install:all": "npm run install:server && npm run install:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "start:server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint": "npm run lint:server && npm run lint:client",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client"
  },
  "keywords": [
    "mern",
    "react",
    "nodejs",
    "express",
    "mongodb",
    "ci-cd",
    "github-actions",
    "vite",
    "vitest",
    "testing"
  ],
  "author": "Chandra Shekar",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
