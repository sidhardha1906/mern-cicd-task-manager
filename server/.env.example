# Server Port (default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/taskmanager
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# Allowed Client Origin for CORS (e.g., http://localhost:5173 for local Vite dev server or production URL)
CLIENT_URL=http://localhost:5173
